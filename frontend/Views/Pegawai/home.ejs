<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sistem Cuti PPSDM BMKG</title>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <link href="output.css" rel="stylesheet" />
        <style>
            /* Previous styles remain the same */
            .hero-section {
                position: relative;
                height: 60vh;
                width: 100%;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .hero-bg {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: url("home.png");
                background-size: cover;
                background-position: center;
                z-index: -2;
            }

            .hero-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.6);
                z-index: -1;
            }

            /* Mobile dropdown animation */
            .mobile-menu {
                transition: max-height 0.3s ease-in-out;
                max-height: 0;
                overflow: hidden;
            }

            .mobile-menu.show {
                max-height: 300px;
            }

            /* Rest of the previous styles... */
        </style>
    </head>
    <body class="font-poppins bg-gray-50">
        <!-- Header -->
        <header class="bg-white shadow-sm fixed w-full top-0 z-50">
            <div class="container mx-auto px-4 lg:px-6 py-4">
                <!-- Desktop Layout -->
                <div class="flex justify-between items-center">
                    <!-- Logo Section -->
                    <div class="flex items-center space-x-4">
                        <img
                            src="Logo PPSDM.png"
                            alt="Logo PPSDM BMKG"
                            class="h-10 w-auto"
                        />
                        <h1 class="text-xl font-bold text-gray-800">
                            PPSDM BMKG
                        </h1>
                    </div>

                    <!-- Centered Navigation (Desktop) -->
                    <nav
                        class="hidden md:block absolute left-1/2 transform -translate-x-1/2"
                    >
                        <ul class="flex space-x-8">
                            <li>
                                <a
                                    href="/"
                                    class="nav-link text-gray-600 hover:text-gray-800 font-medium transition-colors duration-200 text-teal-500 text-gray-900 "
                                >
                                    Home
                                </a>
                            </li>
                            <li>
                                <a
                                    href="/riwayat"
                                    class="nav-link text-gray-600 hover:text-teal-500 hover:bg-gray-100 font-medium transition-colors duration-200"
                                >
                                    Riwayat
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <!-- Right Side - User Profile -->
                    <div class="flex items-center gap-x-4">
                        <!-- User Welcome (Desktop) -->
                        <div class="hidden md:flex flex-col text-right">
                            <span class="text-gray-500 text-sm">Welcome,</span>
                            <span class="text-teal-500 text-sm font-medium"
                                ><%= user.nama %></span
                            >
                        </div>

                        <!-- Profile Dropdown -->
                        <div class="relative inline-flex">
                            <button
                                id="profile-dropdown"
                                aria-expanded="false"
                                aria-haspopup="true"
                                class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-gray-200 hover:border-gray-300 transition-all duration-200"
                            >
                                <img
                                    src="/profile2.png"
                                    alt="Profile picture"
                                    class="w-9 h-9 rounded-full object-cover"
                                />
                            </button>

                            <!-- Profile Dropdown Menu -->
                            <div
                                id="profile-menu"
                                class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-1"
                            >
                                <div class="px-4 py-2 border-b border-gray-100">
                                    <p class="text-sm text-gray-500">
                                        Signed in as
                                    </p>
                                    <p
                                        class="text-sm font-medium text-gray-800"
                                    >
                                        <%= user.nama %>
                                    </p>
                                </div>
                                <a
                                    href="#profile"
                                    class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                                    >Ubah Password</a
                                >
                                <form action="/auth/logout" method="post">
                                    <button
                                        type="submit"
                                        class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50"
                                    >
                                        Logout
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Mobile Menu Toggle -->
                        <button
                            id="mobile-menu-button"
                            class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-orange-500 hover:bg-gray-100 focus:outline-none transition duration-150 ease-in-out"
                            aria-label="Main menu"
                            aria-expanded="false"
                        >
                            <svg
                                class="h-6 w-6"
                                stroke="currentColor"
                                fill="none"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    class="menu-open"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 6h16M4 12h16M4 18h16"
                                />
                                <path
                                    class="menu-close hidden"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"
                                />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Mobile Menu Dropdown -->
                <div id="mobile-menu" class="mobile-menu md:hidden">
                    <nav class="px-2 pt-2 pb-3 space-y-1">
                        <a
                            href="#home"
                            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-orange-500 hover:bg-gray-50 transition duration-150 ease-in-out"
                        >
                            Home
                        </a>
                        <a
                            href="#riwayat"
                            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-orange-500 hover:bg-gray-50 transition duration-150 ease-in-out"
                        >
                            Riwayat
                        </a>
                        <div class="px-3 py-2 border-t border-gray-200 mt-2">
                            <p class="text-sm text-gray-500">Signed in as</p>
                            <p class="text-sm font-medium text-teal-500">
                                <%= user.nama %>
                            </p>
                        </div>
                    </nav>
                </div>
            </div>
        </header>

        <!-- Spacer for fixed header -->
        <div class="pt-24"></div>

        <!-- Hero Section with improved text contrast -->
        <section class="hero-section">
            <div class="hero-bg"></div>
            <div class="hero-overlay"></div>
            <div class="hero-content text-center">
                <h1 class="text-white text-4xl md:text-5xl font-bold mb-2">
                    Selamat Datang di
                </h1>
                <h2 class="text-white text-3xl md:text-4xl font-semibold">
                    Sistem Pengajuan
                    <span class="text-orange-400">Cuti Tahunan</span> PPSDM BMKG
                </h2>
            </div>
        </section>

        <!-- Main Content with improved layout -->
        <main class="container mx-auto px-12 py-14">
            <div
                class="flex flex-col md:flex-row gap-8 items-center justify-center max-w-6xl mx-auto"
            >
                <!-- Left side - Leave Balance Box -->
                <div class="w-full md:w-1/3">
                    <div class="bg-white rounded-xl border p-20 shadow-[10px_10px_10px_0px_rgba(0,0,0,0.15)]">
                        <div class="text-center">
                            <p
                                class="text-2xl text-gray-800 font-semibold mb-4"
                            >
                                Sisa Cuti
                            </p>
                            <p class="text-8xl font-bold text-orange-500 mb-1">
                                <%= remainingLeave %>
                            </p>
                            <p class="text-2xl text-gray-600">Hari</p>
                        </div>
                    </div>
                </div>

                <!-- Right side - Leave Request Text -->
                <div
                    class="w-full md:w-2/3 flex flex-col items-center justify-center"
                >
                    <div class="text-center">
                        <% if (remainingLeave > 0) { %>
                            <h2 class="text-3xl text-gray-800 font-semibold mb-3">
                              Anda Masih Memiliki Jatah Cuti
                            </h2>
                            <h2 class="text-3xl text-gray-800 font-semibold mb-8">
                                Silahkan Diajukan
                            </h2>
                            <button
                            id="open-modal"
                            class="px-12 py-4 bg-orange-500 text-white rounded-lg text-xl font-medium hover:bg-orange-600 transition-colors"
                        >
                            Ajukan Cuti
                        </button>
                          <% } else { %>
                            <h2 class="text-3xl text-gray-800 font-semibold mb-3">
                              Jatah Cuti Anda Sudah Habis
                            </h2>
                          <% } %>

                        <!-- Button to Open Modal -->


                        <!-- Modal Form Pengajuan Cuti -->
                        <div
                            id="cuti-modal"
                            class="hidden fixed inset-0 z-50 flex items-center justify-center bg-gray-900 bg-opacity-50 transition-opacity duration-300"
                        >
                            <div
                                id="modal-content"
                                class="bg-white rounded-xl shadow-lg max-w-lg w-full p-6 transform scale-95 opacity-0 transition-all duration-300"
                            >
                                <!-- Header -->
                                <div class="flex justify-between items-center">
                                    <h2
                                        class="text-2xl font-bold text-gray-800"
                                    >
                                        Pengajuan Cuti Tahunan
                                    </h2>
                                    <button
                                        id="close-modal"
                                        class="text-gray-500 hover:text-gray-700 text-xl"
                                    >
                                        &times;
                                    </button>
                                </div>

                                <!-- Form -->
                                <form
                                    id="cutiForm"
                                    action="/apply"
                                    method="post"
                                    class="mt-5 space-y-4"
                                >
                                    <!-- Hidden Fields -->
                                    <input
                                        type="hidden"
                                        name="NIP"
                                        value="<%= user.NIP %>"
                                    />
                                    <input
                                        type="hidden"
                                        name="applicationYear"
                                        value="<%= new Date().getFullYear() %>"
                                    />
                                    <input
                                        type="hidden"
                                        name="jenis_cuti"
                                        value="Tahunan"
                                    />
                                    <!-- Hidden field untuk requestedDays yang akan dihitung secara client-side -->
                                    <input
                                        type="hidden"
                                        id="requestedDays"
                                        name="requestedDays"
                                        value=""
                                    />

                                    <!-- Alasan Cuti -->
                                    <div>
                                        <label
                                            for="keterangan"
                                            class="block text-sm font-medium text-gray-700"
                                            >Alasan Cuti</label
                                        >
                                        <textarea
                                            id="keterangan"
                                            name="keterangan"
                                            class="mt-1 w-full border border-gray-300 rounded-lg p-3 focus:ring-orange-500 focus:border-orange-500"
                                            rows="3"
                                            placeholder="Masukkan Alasan Cuti"
                                        ></textarea>
                                    </div>

                                    <!-- Mulai Cuti -->
                                    <div>
                                        <label
                                            for="tanggal_mulai"
                                            class="block text-sm font-medium text-gray-700"
                                            >Mulai Cuti</label
                                        >
                                        <input
                                            type="date"
                                            id="tanggal_mulai"
                                            name="tanggal_mulai"
                                            class="mt-1 w-full border border-gray-300 rounded-lg p-3 focus:ring-orange-500 focus:border-orange-500"
                                        />
                                    </div>

                                    <!-- Selesai Cuti -->
                                    <div>
                                        <label
                                            for="tanggal_selesai"
                                            class="block text-sm font-medium text-gray-700"
                                            >Selesai Cuti</label
                                        >
                                        <input
                                            type="date"
                                            id="tanggal_selesai"
                                            name="tanggal_selesai"
                                            class="mt-1 w-full border border-gray-300 rounded-lg p-3 focus:ring-orange-500 focus:border-orange-500"
                                        />
                                    </div>

                                    <!-- Submit Button -->
                                    <button
                                        type="submit"
                                        class="w-full py-3 bg-orange-500 text-white rounded-lg text-lg font-semibold hover:bg-orange-600"
                                    >
                                        Ajukan Cuti
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Leave Status Table -->
            <div class="bg-white rounded-xl mt-24 p-6 shadow-md">
                <h3 class="text-xl font-semibold mb-6">
                    Status Pengajuan Cuti
                </h3>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="text-left">
                                <th class="pb-4 text-gray-500">No</th>
                                <th class="pb-4 text-gray-500">Alasan Cuti</th>
                                <th class="pb-4 text-gray-500">Mulai Cuti</th>
                                <th class="pb-4 text-gray-500">Selesai Cuti</th>
                                <th class="pb-4 text-gray-500">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (leaveRequests && leaveRequests.length > 0) {
                            %> <% leaveRequests.forEach((cuti, index) => { %>
                            <tr class="border-t border-gray-100">
                                <td class="py-4"><%= index + 1 %></td>
                                <td class="py-4"><%= cuti.keterangan %></td>
                                <td class="py-4">
                                    <%= new
                                    Date(cuti.tanggal_mulai).toLocaleDateString()
                                    %>
                                </td>
                                <td class="py-4">
                                    <%= new
                                    Date(cuti.tanggal_selesai).toLocaleDateString()
                                    %>
                                </td>
                                <td class="py-4 text-blue-500">
                                    <%= cuti.status %>
                                </td>
                            </tr>
                            <% }); %> <% } else { %>
                            <tr>
                                <td
                                    colspan="5"
                                    class="py-4 text-center text-gray-500"
                                >
                                    Belum ada pengajuan cuti
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <script>
            // Modal Functionality
            const modal = document.getElementById("cuti-modal");
            const modalContent = document.getElementById("modal-content");
            const openModalBtn = document.getElementById("open-modal");
            const closeModalBtn = document.getElementById("close-modal");

            function openModal() {
                modal.classList.remove("hidden");
                setTimeout(() => {
                    modal.classList.add("opacity-100");
                    modalContent.classList.add("scale-100", "opacity-100");
                }, 10);
            }

            function closeModal() {
                modal.classList.remove("opacity-100");
                modalContent.classList.remove("scale-100", "opacity-100");
                setTimeout(() => modal.classList.add("hidden"), 300);
            }

            openModalBtn.addEventListener("click", openModal);
            closeModalBtn.addEventListener("click", closeModal);
            modal.addEventListener(
                "click",
                (e) => e.target === modal && closeModal()
            );

            // Mobile Menu Toggle
            const mobileMenuButton =
                document.getElementById("mobile-menu-button");
            const mobileMenu = document.getElementById("mobile-menu");
            const menuIcons = {
                open: mobileMenuButton.querySelector(".menu-open"),
                close: mobileMenuButton.querySelector(".menu-close"),
            };

            mobileMenuButton.addEventListener("click", () => {
                const isExpanded =
                    mobileMenuButton.getAttribute("aria-expanded") === "true";
                mobileMenuButton.setAttribute("aria-expanded", !isExpanded);
                mobileMenu.classList.toggle("show");
                menuIcons.open.classList.toggle("hidden");
                menuIcons.close.classList.toggle("hidden");
            });

            // Profile Dropdown
            const profileDropdown = document.getElementById("profile-dropdown");
            const profileMenu = document.getElementById("profile-menu");

            profileDropdown.addEventListener("click", (e) => {
                e.stopPropagation();
                const isExpanded =
                    profileDropdown.getAttribute("aria-expanded") === "true";
                profileDropdown.setAttribute("aria-expanded", !isExpanded);
                profileMenu.classList.toggle("hidden");
            });

            // Close All Dropdowns
            document.addEventListener("click", () => {
                profileMenu.classList.add("hidden");
                profileDropdown.setAttribute("aria-expanded", "false");
            });

            // Responsive Cleanup
            window.addEventListener("resize", () => {
                if (window.innerWidth >= 768) {
                    mobileMenu.classList.remove("show");
                    menuIcons.open.classList.remove("hidden");
                    menuIcons.close.classList.add("hidden");
                    mobileMenuButton.setAttribute("aria-expanded", "false");
                }
            });
        </script>
        <script>
            // Saat form disubmit, hitung selisih tanggal sebagai requestedDays
            document
                .getElementById("cutiForm")
                .addEventListener("submit", function (e) {
                    const startInput =
                        document.getElementById("tanggal_mulai").value;
                    const endInput =
                        document.getElementById("tanggal_selesai").value;
                    if (!startInput || !endInput) {
                        // Jika salah satu tanggal tidak diisi, biarkan form mengirimkan nilai kosong.
                        return;
                    }
                    const startDate = new Date(startInput);
                    const endDate = new Date(endInput);
                    // Hitung jumlah hari (inklusif)
                    const diffTime = endDate - startDate;
                    const diffDays =
                        Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                    // Set nilai hidden field requestedDays

                    if(diffDays < 0){
                        e.preventDefault();
                        Swal.fire({
                            title: 'Gagal!',
                            text: 'Tanggal selesai cuti tidak boleh lebih awal dari tanggal mulai cuti',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    } else {
                        document.getElementById("requestedDays").value = diffDays;
                    }
                    document.getElementById("requestedDays").value = diffDays;
                });
        </script>
        <script>
            <% if (success && success.length > 0) { %>
            Swal.fire({
                title: 'Berhasil!',
                text: '<%= success[0] %>',
                icon: 'success',
                confirmButtonText: 'OK'
            }).then((result) => {
                if (result.isConfirmed) {
                location.reload();
                }
            });
            <% } else if (error && error.length > 0) { %>
            Swal.fire({
                title: 'Gagal!',
                text: '<%= error[0] %>',
                icon: 'error',
                confirmButtonText: 'OK'
            }).then((result) => {
                if (result.isConfirmed) {
                location.reload();
                }
            });
            <% } %>
        </script>
    </body>
</html>
