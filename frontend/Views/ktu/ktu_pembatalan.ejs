<%-include ('ktuHeader') %>
      <!-- Stats Cards -->
      <div class="px-24">
        <!-- Tables -->
        <div class="flex flex-col">
            <div class="-m-1.5 overflow-x-auto">
              <div class="p-1.5 min-w-full inline-block align-middle">
                <h2 class="text-2xl font-semibold mb-4 py-4">Data Cuti yang di setujui</h2>
  
                <div class="border rounded-lg overflow-hidden dark:border-neutral-400 mb-8">
                  <table class="min-w-full text-left border-collapse" style="table-layout: fixed;">
                    <thead>
                      <tr class="bg-gray-100">
                        <th class="px-4 py-3 text-start text-base font-light text-gray-400">No</th>
                        <th class="px-4 py-3 text-start text-base font-light text-gray-400">Tanggal Pengajuan</th>
                        <th class="px-4 py-3 text-start text-base font-light text-gray-400">Nama</th>
                        <th class="px-4 py-3 text-start text-base font-light text-gray-400">Alasan</th>
                        <th class="px-4 py-3 text-start text-base font-light text-gray-400">Mulai Cuti</th>
                        <th class="px-4 py-3 text-start text-base font-light text-gray-400">Selesai Cuti</th>
                        <th class="px-4 py-3 text-start text-base font-light text-gray-400">Aksi</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (leaveRequests && leaveRequests.length > 0) { %>
                        <% leaveRequests.forEach((cuti, index) => { %>
                          <tr class="border-b hover:bg-gray-50">
                            <td class="px-6 py-4"><%= index + 1 %></td>
                            <td class="px-6 py-4"><%= new Date(cuti.createdAt).toLocaleDateString() %></td>
                            <td class="px-6 py-4"><%= cuti.Pegawai ? cuti.Pegawai.nama : "-" %></td>
                            <td class="px-6 py-4"><%= cuti.keterangan %></td>
                            <td class="px-6 py-4"><%= new Date(cuti.tanggal_mulai).toLocaleDateString() %></td>
                            <td class="px-6 py-4"><%= new Date(cuti.tanggal_selesai).toLocaleDateString() %></td>
                            <td class="px-6 py-4 text-center">
                              <button type="button" class="py-3 px-4 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-transparent bg-red-500 text-white hover:bg-red-700 focus:outline-none"
                                      onclick="openCancelModal('<%= cuti.id %>', '<%= cuti.Pegawai ? cuti.Pegawai.nama : '' %>')">
                                Batalkan
                              </button>
                            </td>
                          </tr>
                        <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="7" class="px-4 py-2 text-center text-gray-500">
                            Belum ada pengajuan cuti
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                  <!-- Modal Pembatalan -->
<div id="cancelModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg p-8 max-w-md w-full mx-4">
    <div class="text-center mb-6">
      <h2 class="text-xl font-semibold mb-4">Pembatalan Pengajuan Cuti</h2>
      <p class="text-lg font-medium mb-2" id="modalEmployeeName"></p>
    </div>
    <div class="flex justify-center space-x-4">
      <button type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 hover:bg-gray-50"
              onclick="hideCancelModal()">Tidak</button>
      <button type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-transparent bg-red-500 text-white hover:bg-red-600"
              onclick="submitCancel()">Iya, Batalkan</button>
    </div>
  </div>
</div>

<script>
  let selectedCancelId = null;
  function openCancelModal(id, employeeName) {
    selectedCancelId = id;
    document.getElementById('modalEmployeeName').textContent = `Batalkan pengajuan cuti oleh ${employeeName}?`;
    document.getElementById('cancelModal').classList.remove('hidden');
  }

  function hideCancelModal() {
    document.getElementById('cancelModal').classList.add('hidden');
  }

  function submitCancel() {
    fetch(`/ktu/cancel/${selectedCancelId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: "Dibatalkan" })
    })
    .then(res => res.json())
    .then(data => {
      Swal.fire({
        title: "Berhasil",
        text: data.message || "Pengajuan cuti berhasil dibatalkan.",
        icon: "success",
        confirmButtonText: "OK"
      }).then(() => {
        location.reload();
      });
    })
    .catch(error => {
      console.error("Error:", error);
      Swal.fire({
        title: "Error",
        text: "Terjadi kesalahan saat membatalkan pengajuan cuti.",
        icon: "error",
        confirmButtonText: "OK"
      });
    });
  }
</script>
                  
                  <!-- Pagination -->
                <div class="flex justify-end py-4 px-12">
                  <nav class="flex items-center gap-x-1 mt-4 ml-auto" aria-label="Pagination">
                    <div class="flex items-center gap-x-1">
                        <button type="button" class="min-h-[38px] min-w-[38px] flex justify-center items-center bg-orange-400 text-white py-2 px-3 text-sm rounded-lg focus:outline-none focus:bg-gray-300 disabled:opacity-50 disabled:pointer-events-none " aria-current="page">1</button>
                        <button type="button" class="min-h-[38px] min-w-[38px] flex justify-center items-center text-gray-800 hover:bg-gray-100 py-2 px-3 text-sm rounded-lg focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none ">2</button>
                        <button type="button" class="min-h-[38px] min-w-[38px] flex justify-center items-center text-gray-800 hover:bg-gray-100 py-2 px-3 text-sm rounded-lg focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none ">3</button>
                    </div>
                    <button type="button" class="min-h-[38px] min-w-[38px] py-2 px-2.5 inline-flex justify-center items-center gap-x-1.5 text-sm rounded-lg text-gray-800 hover:bg-gray-100 focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none " aria-label="Next">
                        <span>Next</span>
                        <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6"></path>
                        </svg>
                    </button>
                </nav>
              </div>
                <!-- End Pagination -->
                  
                </div>
              </div>
            </div>
          </div>
        </div>
        <%- include ("modal.ejs")%>
        <script src="../preline.js"></script>
</body>
</html>