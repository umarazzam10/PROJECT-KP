<%-include ('ktuHeader') %>

      <!-- Stats Cards -->
    <div class="px-24">
      <!-- Tables -->
      <div class="flex flex-col">
          <div class="-m-1.5 overflow-x-auto">
            <div class="p-1.5 min-w-full inline-block align-middle">
              <h2 class="text-2xl font-semibold mb-4 py-4">Data Pegawai</h2>
              <div class="flex justify-end mb-4">
                <button class="bg-orange-400 text-white text-base px-6 py-3 rounded-2xl flex items-center gap-2 hover:bg-orange-600" onclick="window.location.href='/ktu/tambahpegawai'">
                  <img src="\plus-circle.png" alt="Plus Icon" class="w-4 h-4" />
                  Tambah Pegawai
                </button>
              </div>

              <div class="border rounded-lg overflow-hidden border-neutral-200">
                <table class="min-w-full text-left border-collapse" style="table-layout: fixed;">
                  <thead>
                    <tr>
                      <th class="px-4 py-3 text-start text-base font-light text-gray-400 dark:text-neutral-500">No</th>
                      <th class="px-4 py-3 text-start text-base font-light text-gray-400 dark:text-neutral-500">Nama</th>
                      <th class="px-4 py-3 text-start text-base font-light text-gray-400 dark:text-neutral-500">NIP</th>
                      <th class="px-4 py-3 text-start text-base font-light text-gray-400 dark:text-neutral-500">Jumlah Hak Cuti</th>
                      <th class="px-4 py-3 text-start text-base font-light text-gray-400 dark:text-neutral-500">Sisa Cuti</th>
                      <th class="px-4 py-3 text-center text-base font-light text-gray-400 dark:text-neutral-500">Aksi</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-200">
                    <% if (pegawais && pegawais.length > 0) { %>
                      <% pegawais.forEach((pegawai, index) => { %>
                        <tr class="border-b hover:bg-gray-50">
                          <td class="px-4 py-3"><%= index + 1 %></td>
                          <td class="px-4 py-3"><%= pegawai.nama %></td>
                          <td class="px-4 py-3"><%= pegawai.NIP %></td>
                          <td class="px-4 py-3"><%= pegawai.totalHakCuti %> hari</td>
                          <td class="px-4 py-3"><%= pegawai.sisaCuti %> hari</td>
                          <td class="px-4 py-3 text-center">
                            <button onclick="deletePegawai('<%= pegawai.id %>')" class="py-2 px-4 bg-red-500 text-white rounded-lg hover:bg-red-700 focus:outline-none">
                              <img src="/x-circle.png" alt="Hapus" class="w-5 h-5 inline-block" />
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="6" class="px-4 py-3 text-center text-gray-500">
                          Tidak ada data pegawai
                        </td>
                      </tr>
                    <% } %>

                    <script>
                      function deletePegawai(id) {
                        Swal.fire({
                          title: 'Apakah Anda yakin?',
                          text: "Data pegawai akan dihapus secara permanen.",
                          icon: 'warning',
                          showCancelButton: true,
                          confirmButtonColor: '#3085d6',
                          cancelButtonColor: '#d33',
                          confirmButtonText: 'Ya, hapus!'
                        }).then((result) => {
                          if (result.isConfirmed) {
                            fetch(`/data-pegawai/${id}`, {
                              method: 'DELETE',
                              headers: { 'Content-Type': 'application/json' }
                            })
                            .then(response => response.json())
                            .then(data => {
                              Swal.fire(
                                'Terhapus!',
                                data.message,
                                'success'
                              ).then(() => {
                                location.reload();
                              });
                            })
                            .catch(error => {
                              console.error('Error:', error);
                              Swal.fire('Error!', 'Terjadi kesalahan saat menghapus pegawai.', 'error');
                            });
                          }
                        });
                      }
                    </script>
                  </tbody>
                </table>
                <!-- Pagination -->
              <div class="flex justify-end py-4 px-12">
                <nav class="flex items-center gap-x-1 mt-4 ml-auto" aria-label="Pagination">
                  <div class="flex items-center gap-x-1">
                      <button type="button" class="min-h-[38px] min-w-[38px] flex justify-center items-center bg-orange-400 text-white py-2 px-3 text-sm rounded-lg focus:outline-none focus:bg-gray-300 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-600 dark:text-white dark:focus:bg-neutral-500" aria-current="page">1</button>
                      <button type="button" class="min-h-[38px] min-w-[38px] flex justify-center items-center text-gray-800 hover:bg-gray-100 py-2 px-3 text-sm rounded-lg focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none dark:text-white dark:hover:bg-white/10 dark:focus:bg-white/10">2</button>
                      <button type="button" class="min-h-[38px] min-w-[38px] flex justify-center items-center text-gray-800 hover:bg-gray-100 py-2 px-3 text-sm rounded-lg focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none dark:text-white dark:hover:bg-white/10 dark:focus:bg-white/10">3</button>
                  </div>
                  <button type="button" class="min-h-[38px] min-w-[38px] py-2 px-2.5 inline-flex justify-center items-center gap-x-1.5 text-sm rounded-lg text-gray-800 hover:bg-gray-100 focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none dark:text-white dark:hover:bg-white/10 dark:focus:bg-white/10" aria-label="Next">
                      <span>Next</span>
                      <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m9 18 6-6-6-6"></path>
                      </svg>
                  </button>
              </nav>
            </div>
              <!-- End Pagination -->
                
              </div>
            </div>
          </div>
        </div>
      </div>
      <%- include ("modal.ejs")%>
      <script src="../preline.js"></script>
</body>
</html>